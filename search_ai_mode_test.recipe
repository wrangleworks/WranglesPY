# Run with run_search_ai_mode.py, which supplies the input DataFrame and settings.
# Required input columns: ID, Description, Mfr, MPN, part_codes (list), query.
# The SerpAPI client reads SERPAPI_API_KEY from the environment.

wrangles:
  # Retain all supplied product evidence in the single AI Mode query.
  - create.jinja:
      output: search_query
      template:
        string: |-
          Description: {{ Description }}
          Mfr: {{ Mfr }}
          MPN: {{ MPN }}
          part_codes: {{ part_codes | tojson }}
          query: {{ query }}

  - search.ai_mode:
      queries: search_query
      id: ID
      output:
        - ai_mode_results
        - ai_mode_text
        - reconstructed_markdown
      client: serpapi
      n_results: ${N_RESULTS}
      threads: ${THREADS}
      country: ${COUNTRY}
      language: ${LANGUAGE}

  # Retain the original Markdown alongside the cleaned version for comparison.
  - standardize.clean:
      input: reconstructed_markdown
      output: reconstructed_markdown_clean
      unescape_unicode: true
      latex_to_text: true
      collapse_whitespace: false
      trim: false
      uncurl_quotes: false
      unescape_html: false

  - custom.clean_ai_mode_links:
      input: reconstructed_markdown_clean
