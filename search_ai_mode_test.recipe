# Run with run_search_ai_mode.py, which supplies the input DataFrame and settings.
# Required input columns: ID, Description, Mfr, MPN, part_codes (list), query.
# The SerpAPI client reads SERPAPI_API_KEY from the environment.

wrangles:
  # Give Jinja the same structured configuration passed to the search parser.
  - create.column:
      output: __ai_mode_query_config
      value: ${AI_MODE_QUERY}
      value_if_exists: new

  - create.jinja:
      output: search_query
      template:
        string: |-
          {% for entry in __ai_mode_query_config %}{% if 'base_query' in entry %}{{ entry.base_query }}
          {% endif %}{% endfor %}
          {% for entry in __ai_mode_query_config %}{% for heading, instruction in entry.items() %}{% if heading not in ['base_query', 'query_suffix'] %}{{ heading | trim }}: {{ instruction }}
          {% endif %}{% endfor %}{% endfor %}
          Description: {{ Description }}
          Mfr: {{ Mfr }}
          MPN: {{ MPN }}
          part_codes: {{ part_codes | tojson }}
          query: {{ query }}
          {% for entry in __ai_mode_query_config %}{% if 'query_suffix' in entry %}{{ entry.query_suffix }}{% endif %}{% endfor %}

  - drop:
      columns: __ai_mode_query_config

  - search.ai_mode:
      queries: search_query
      id: ID
      query_config: ${AI_MODE_QUERY}
      output:
        - ai_mode_result
        - ai_mode_markdown
      client: serpapi
      threads: ${THREADS}
      country: ${COUNTRY}
      language: ${LANGUAGE}

  # Retain the original Markdown alongside the cleaned version for comparison.
  - standardize.clean:
      input: ai_mode_markdown
      output: ai_mode_markdown_clean
      unescape_unicode: true
      latex_to_text: true
      collapse_whitespace: false
      trim: false
      uncurl_quotes: false
      unescape_html: false

  - custom.clean_ai_mode_links:
      input: ai_mode_markdown_clean
